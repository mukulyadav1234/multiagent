# Which provider the agents use: gemini (default) or openrouter
LLM_PROVIDER=gemini

# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=your_gemini_key_here
# Optional per-agent overrides. A comma-separated list is a fallback chain: when a model
# is busy (503), out of quota (429) or retired (404), the next one is tried.
# GEMINI_MODEL_BRIEF=gemini-3-flash-preview,gemini-3.5-flash,gemini-2.5-flash
# GEMINI_MODEL_DIRECTOR=gemini-3-flash-preview,gemini-3.5-flash,gemini-2.5-flash
# GEMINI_MODEL_CODER=gemini-3.5-flash,gemini-3-flash-preview,gemini-2.5-flash
# GEMINI_MODEL_REVIEWER=gemini-3-flash-preview,gemini-3.5-flash,gemini-2.5-flash   (must accept images)

# --- OpenRouter (only used when LLM_PROVIDER=openrouter) ---
# OPENROUTER_API_KEY=
# Defaults are free models; set MODEL_BRIEF / MODEL_DIRECTOR / MODEL_CODER / MODEL_REVIEWER to override.

CODER_MAX_TOKENS=48000
# Render -> review -> revise loops (0 = off, faster)
REVIEW_ROUNDS=1
# Preview pixel density; downloads offer 2x and 4x separately
PREVIEW_SCALE=2

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
MAX_AGENT_RETRIES=2
OUTPUT_DIR=outputs
SSL_VERIFY=true
# Behind a TLS-inspecting proxy? Point at the system bundle (auto-detected on Debian/Ubuntu)
# CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
